{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gitroast-ai-frontend",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-26",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "gitroast.ai",
      "custom_domain": true
    }
  ]
}
