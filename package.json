{
  "name": "gitroast-ai-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "opennextjs-cloudflare build && node scripts/patch-opennext-worker.mjs",
    "deploy": "npm run build:cloudflare && npm run deploy:direct",
    "deploy:direct": "wrangler deploy .open-next/worker.js --assets .open-next/assets --name gitroast-ai-frontend --compatibility-date 2026-07-26 --compatibility-flags nodejs_compat --autoconfig=false --keep-vars",
    "lint": "eslint . --ext .js,.mjs,.ts,.tsx --max-warnings=0",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "test:frontend": "vitest run",
    "test:gateway": "vitest run workers/gateway/src/index.test.ts",
    "gateway:check": "wrangler deploy --config workers/gateway/wrangler.toml --dry-run --outdir workers/gateway/dist --env preview",
    "test:e2e:live": "playwright test",
    "bundle:check": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.19.1",
    "@sentry/browser": "^10.68.0",
    "@tanstack/react-query": "^5.90.11",
    "framer-motion": "^12.43.0",
    "gsap": "^3.13.0",
    "lenis": "^1.3.17",
    "lucide-react": "^0.468.0",
    "next": "15.5.21",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.2",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^18.3.27",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^8.57.1",
    "eslint-config-next": "15.5.21",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^27.2.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14",
    "wrangler": "^4.114.0"
  },
  "overrides": {
    "@opennextjs/aws": {
      "minimatch": "10.2.6"
    },
    "brace-expansion": "5.0.8",
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
